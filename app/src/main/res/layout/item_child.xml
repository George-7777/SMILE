<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground">

        <!-- Аватар (иконка ребёнка) -->
        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="8dp"
            app:srcCompat="@drawable/baseline_face_24" />

        <!-- Информация о ребёнке -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_child_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_name_kid"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tv_child_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_username_kid"
                android:textSize="13sp"
                android:textColor="@android:color/darker_gray" />

            <TextView
                android:id="@+id/tv_tasks_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/template_count_tasks_kid"
                android:textSize="12sp"
                android:textColor="@color/primary_blue"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- Стрелка вправо (переход к задачам) -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:srcCompat="@drawable/baseline_chevron_right_24"
            app:tint="@android:color/darker_gray" />

    </LinearLayout>

</androidx.cardview.widget.CardView>